{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "fix-appliance-crm",
          "appId": "1:772324431093:android:1bab4004783335bd2fe1bc",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "fix-appliance-crm",
          "appId": "1:772324431093:ios:938ae81b4f55fc382fe1bc",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "fix-appliance-crm",
          "configurations": {
            "android": "1:772324431093:android:1bab4004783335bd2fe1bc",
            "ios": "1:772324431093:ios:938ae81b4f55fc382fe1bc",
            "macos": "1:772324431093:ios:c906214ef15ddd782fe1bc",
            "web": "1:772324431093:web:5fc387809e29e86d2fe1bc",
            "windows": "1:772324431093:web:249e7ec3fc1462e02fe1bc"
          }
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "fxapca",
    "public": "hosting/public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/tech/sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/download/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      }
    ],
    "rewrites": [
      { "source": "/tech", "destination": "/tech/index.html" },
      { "source": "/tech/**", "destination": "/tech/index.html" },
      { "source": "/p", "function": "p" },
      { "source": "/p/**", "function": "p" },
      { "source": "/e", "function": "p" },
      { "source": "/e/**", "function": "p" },
      { "source": "/i", "function": "p" },
      { "source": "/i/**", "function": "p" },
      { "source": "/pay", "function": "p" },
      { "source": "/pay/**", "function": "p" },
      { "source": "/estimate", "function": "p" },
      { "source": "/estimate/**", "function": "p" },
      { "source": "/invoice", "function": "p" },
      { "source": "/invoice/**", "function": "p" },
      { "source": "/**", "function": "p" }
    ]
  }
}
