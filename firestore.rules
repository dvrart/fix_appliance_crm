rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userCompanyId() {
      return signedIn() && exists(userPath())
        ? get(userPath()).data.companyId
        : null;
    }

    function isMember(cid) {
      return signedIn()
        && userCompanyId() == cid
        && exists(/databases/$(database)/documents/companies/$(cid)/members/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.companyId is string
        && request.resource.data.role is string;
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.companyId == resource.data.companyId;
    }

    match /companies/{cid} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string;
      allow read: if isMember(cid)
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update: if (isMember(cid) || (signedIn() && resource.data.ownerUid == request.auth.uid))
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['subscription', 'ownerUid']);

      match /members/{uid} {
        allow read, write: if signedIn() && request.auth.uid == uid;
        allow read: if isMember(cid);
      }

      match /{document=**} {
        allow read, write: if isMember(cid);
      }
    }
  }
}
