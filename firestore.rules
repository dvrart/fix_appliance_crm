rules_version = '2';

// Доступ к базе только для вошедших пользователей приложения (Firebase Auth).
// Cloud Functions работают через Admin SDK и правила обходят.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
