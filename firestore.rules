rules_version = '2';

// Доступ к базе:
// 1. Владелец (по фиксированному uid) — полный доступ ко всем коллекциям.
// 2. Активный мастер (документ `companies/fix_appliance_ca/technicians/{uid}` с `active != false`) —
//    видит и обновляет СТРОГО только назначенные ему заявки (`assignedTo == request.auth.uid`),
//    сообщения и звонки по этим заявкам, а также свой профиль и историю своих расчётов.
//    Общая база клиентов, чужие заказы, расходы, склад и отчёты владельца закрыты.
// 3. Тестировщик в тестовой копии CRM — читает и пишет СТРОГО только в свою
//    отдельную базу `companies/$('tester_' + request.auth.uid)/**` (а его собственные
//    подключённые мастера — только свои назначенные заявки внутри этой базы), не имея
//    никакого доступа к `companies/fix_appliance_ca/**` и чужим тестовым базам.
service cloud.firestore {
  match /databases/{database}/documents {
    function owners() {
      return ['Ew8vDgXvuMMwt9gYQUOi7rujNxO2'];
    }
    function isOwner() {
      return request.auth != null && request.auth.uid in owners();
    }
    function isActiveTech() {
      return request.auth != null
        && exists(/databases/$(database)/documents/companies/fix_appliance_ca/technicians/$(request.auth.uid))
        && get(/databases/$(database)/documents/companies/fix_appliance_ca/technicians/$(request.auth.uid)).data.active != false;
    }
    function isTechJob(jobId) {
      return isActiveTech()
        && jobId is string
        && jobId != ''
        && exists(/databases/$(database)/documents/companies/fix_appliance_ca/jobs/$(jobId))
        && get(/databases/$(database)/documents/companies/fix_appliance_ca/jobs/$(jobId)).data.assignedTo == request.auth.uid;
    }
    function isActiveTester(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && (
          !exists(/databases/$(database)/documents/testers/$(uid))
          || get(/databases/$(database)/documents/testers/$(uid)).data.get('active', true) != false
        );
    }
    function isOwnTesterCompany(companyId) {
      return request.auth != null
        && companyId == 'tester_' + request.auth.uid
        && isActiveTester(request.auth.uid);
    }
    function isTesterSubTechOf(companyId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/testers/$(request.auth.uid))
        && get(/databases/$(database)/documents/testers/$(request.auth.uid)).data.get('active', true) != false
        && get(/databases/$(database)/documents/testers/$(request.auth.uid)).data.get('role', '') == 'technician'
        && get(/databases/$(database)/documents/testers/$(request.auth.uid)).data.get('parentCompanyId', '') == companyId
        && exists(/databases/$(database)/documents/companies/$(companyId)/technicians/$(request.auth.uid))
        && get(/databases/$(database)/documents/companies/$(companyId)/technicians/$(request.auth.uid)).data.active != false;
    }

    match /testers/{testerId} {
      allow read: if isOwner() || (request.auth != null && request.auth.uid == testerId);
      allow create: if isOwner() || (
        request.auth != null
        && request.auth.uid == testerId
        && request.resource.data.get('active', true) == true
      );
      allow update: if isOwner() || (
        isActiveTester(testerId)
        && request.resource.data.get('active', true) == resource.data.get('active', true)
      );
      allow delete: if isOwner();
    }

    match /companies/fix_appliance_ca/technicians/{techId} {
      allow read: if isOwner() || (request.auth != null && request.auth.uid == techId);
      allow write: if isOwner();
    }

    match /companies/fix_appliance_ca/technician_settlements/{settlementId} {
      allow read: if isOwner() || (isActiveTech() && resource.data.technicianId == request.auth.uid);
      allow write: if isOwner();
    }

    match /companies/fix_appliance_ca/jobs/{jobId} {
      allow read: if isOwner() || (isActiveTech() && resource.data.assignedTo == request.auth.uid);
      allow create, delete: if isOwner();
      allow update: if isOwner() || (
        isActiveTech()
        && resource.data.assignedTo == request.auth.uid
        && request.resource.data.assignedTo == request.auth.uid
        && request.resource.data.get('deletedAt', null) == resource.data.get('deletedAt', null)
      );

      match /messages/{msgId} {
        allow read, create: if isOwner() || isTechJob(jobId);
        allow update, delete: if isOwner();
      }

      match /changes/{changeId} {
        allow read, create: if isOwner() || isTechJob(jobId);
        allow update, delete: if isOwner();
      }
    }

    match /companies/fix_appliance_ca/messages/{msgId} {
      allow read: if isOwner() || isTechJob(resource.data.get('jobId', ''));
      allow create, delete: if isOwner();
      allow update: if isOwner() || (
        isTechJob(resource.data.get('jobId', ''))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'bodyRu', 'reaction'])
      );
    }

    match /companies/fix_appliance_ca/calls/{callId} {
      allow read: if isOwner()
        || isTechJob(resource.data.get('jobId', ''))
        || isTechJob(resource.data.get('createdJobId', ''));
      allow write: if isOwner();
    }

    match /companies/fix_appliance_ca/service_guide/{guideId} {
      allow read: if isOwner() || isActiveTech();
      allow write: if isOwner();
    }

    match /companies/fix_appliance_ca/statuses/{statusId} {
      allow read: if isOwner() || isActiveTech();
      allow write: if isOwner();
    }

    match /companies/fix_appliance_ca/catalogs/{catalogId} {
      allow read: if isOwner() || isActiveTech();
      allow write: if isOwner();
    }

    match /companies/fix_appliance_ca/settings/{settingId} {
      allow read: if isOwner()
        || (isActiveTech() && settingId in [
          'config',
          'documents',
          'sms_templates',
          'job_statuses',
          'catalog',
          'service_guide_meta'
        ])
        || (isActiveTech() && (
          settingId == 'pending_cell_call_' + request.auth.uid ||
          settingId == 'pending_outbound_call_' + request.auth.uid
        ));
      allow write: if isOwner()
        || (isActiveTech() && (
          settingId == 'pending_cell_call_' + request.auth.uid ||
          settingId == 'pending_outbound_call_' + request.auth.uid
        ));
    }

    match /companies/{companyId} {
      allow read, write: if isOwner() || isOwnTesterCompany(companyId);

      match /{document=**} {
        allow read, write: if isOwner() || isOwnTesterCompany(companyId) || isTesterSubTechOf(companyId);
      }
    }

    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
